[Unit]
Description=Drawbridge mutation runner
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
# Replace with an ordinary user that can read registered repositories and
# write the configured release roots. Git fetch currently runs in Gateway.
User=drawbridge-runner
Group=drawbridge
SupplementaryGroups=docker
UMask=0007
WorkingDirectory=/opt/drawbridge
ExecStart=/opt/drawbridge/.venv/bin/drawbridge-runner --config /etc/drawbridge/runner.yaml
Restart=on-failure
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
ProtectSystem=strict
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/drawbridge /srv/drawbridge
ReadOnlyPaths=/etc/drawbridge

[Install]
WantedBy=multi-user.target
